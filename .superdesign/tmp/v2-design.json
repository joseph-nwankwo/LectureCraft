d-cols-1 lg:grid-cols-10 gap-8\"><div class=\"lg:col-span-6 space-y-8\"><section class=\"bg-white rounded-xl border border-[#E2E8F0] p-5\"><div class=\"flex items-center justify-between mb-6\"><div><h3 class=\"text-sm font-bold text-[#1F2937]\">AI Usage Trend</h3><p class=\"text-[10px] text-[#6B7280] tracking-tight\">Weekly generation distribution</p></div><div class=\"flex gap-2\"><button class=\"px-2 py-1 text-[10px] font-bold text-[#334E68] bg-[#334E68]/10 rounded\">Weekly</button><button class=\"px-2 py-1 text-[10px] font-bold text-[#6B7280] hover:bg-gray-100 rounded\">Monthly</button></div></div><div class=\"h-[200px] w-full relative group\"><svg class=\"w-full h-full\" viewBox=\"0 0 400 100\"><defs><linearGradient id=\"chart-grad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#334E68\" stop-opacity=\"0.1\" /><stop offset=\"100%\" stop-color=\"#334E68\" stop-opacity=\"0\" /></linearGradient></defs><path d=\"M0,80 C50,90 100,20 150,50 C200,80 250,10 300,40 C350,70 400,30 L400,100 L0,100 Z\" fill=\"url(#chart-grad)\" /><path d=\"M0,80 C50,90 100,20 150,50 C200,80 250,10 300,40 C350,70 400,30\" fill=\"none\" stroke=\"#334E68\" stroke-width=\"2\" stroke-linecap=\"round\" /></svg></div></section><section class=\"space-y-4\"> <div class=\"flex items-center justify-between\"><h2 class=\"text-sm font-bold text-[#1F2937] uppercase tracking-wider\">Recent Activity</h2><button class=\"text-[10px] font-bold text-[#334E68]\">Full History</button></div><div class=\"space-y-3\"><div class=\"flex items-center gap-4 p-4 border border-[#E2E8F0] rounded-xl hover:shadow-card transition-all\"><div class=\"h-9 w-9 shrink-0 bg-[#334E68]/5 rounded-lg flex items-center justify-center text-[#334E68]\"><iconify-icon icon=\"lucide:file-text\" class=\"text-lg\"></iconify-icon></div><div class=\"flex-1\"><p class=\"text-sm font-bold text-[#1F2937]\">Quantum Mechanics Notes</p><p class=\"text-[10px] text-[#6B7280]\">Physics • Updated 12m ago</p></div><iconify-icon icon=\"lucide:more-vertical\" class=\"text-[#6B7280]\"></iconify-icon></div><div class=\"flex items-center gap-4 p-4 border border-[#E2E8F0] rounded-xl hover:shadow-card transition-all\"><div class=\"h-9 w-9 shrink-0 bg-green-50 rounded-lg flex items-center justify-center text-green-600\"><iconify-icon icon=\"lucide:check-circle\" class=\"text-lg\"></iconify-icon></div><div class=\"flex-1\"><p class=\"text-sm font-bold text-[#1F2937]\">Midterm Assessment PDF</p><p class=\"text-[10px] text-[#6B7280]\">Calculus • Exported 2h ago</p></div><iconify-icon icon=\"lucide:more-vertical\" class=\"text-[#6B7280]\"></iconify-icon></div></div></section></div><div class=\"lg:col-span-4 space-y-6\"><div class=\"grid grid-cols-2 gap-4\"><div class=\"bg-white border-b-2 border-primary rounded-xl p-4 shadow-card hover:shadow-hover transition-all group\"><p class=\"text-xl font-bold text-[#1F2937]\">12</p><div class=\"flex items-center gap-2 mt-2\"><div class=\"h-6 w-6 bg-[#334E68]/10 text-[#334E68] rounded flex items-center justify-center group-hover:bg-[#334E68] group-hover:text-white transition-colors\"><iconify-icon icon=\"lucide:book-open\" class=\"text-xs\"></iconify-icon></div><span class=\"text-[10px] font-bold uppercase text-[#6B7280]\">Courses</span></div></div><div class=\"bg-white border-b-2 border-success rounded-xl p-4 shadow-card hover:shadow-hover transition-all group\"><p class=\"text-xl font-bold text-[#1F2937]\">148</p><div class=\"flex items-center gap-2 mt-2\"><div class=\"h-6 w-6 bg-green-50 text-green-600 rounded flex items-center justify-center group-hover:bg-green-600 group-hover:text-white transition-colors\"><iconify-icon icon=\"lucide:file-text\" class=\"text-xs\"></iconify-icon></div><span class=\"text-[10px] font-bold uppercase text-[#6B7280]\">Docs</span></div></div><div class=\"bg-white border-b-2 border-gray-200 rounded-xl p-4 shadow-card hover:shadow-hover transition-all group\"><p class=\"text-xl font-bold text-[#1F2937]\">2.4k</p><div class=\"flex items-center gap-2 mt-2\"><div class=\"h-6 w-6 bg-gray-100 text-[#6B7280] rounded flex items-center justify-center group-hover:bg-[#6B7280] group-hover:text-white transition-colors\"><iconify-icon icon=\"lucide:sparkles\" class=\"text-xs\"></iconify-icon></div><span class=\"text-[10px] font-bold uppercase text-[#6B7280]\">AI Gens</span></div></div><div class=\"bg-white border-b-2 border-warning rounded-xl p-4 shadow-card hover:shadow-hover transition-all group\"><p class=\"text-xl font-bold text-[#1F2937]\">842k</p><div class=\"flex items-center gap-2 mt-2\"><div class=\"h-6 w-6 bg-amber-50 text-amber-500 rounded flex items-center justify-center group-hover:bg-amber-500 group-hover:text-white transition-colors\"><iconify-icon icon=\"lucide:zap\" class=\"text-xs\"></iconify-icon></div><span class=\"text-[10px] font-bold uppercase text-[#6B7280]\">Tokens</span></div></div></div><div class=\"bg-white border border-[#E2E8F0] rounded-xl p-5 shadow-card\"><div class=\"flex items-center justify-between mb-4\"><h3 class=\"text-xs font-bold uppercase text-[#1F2937]\">Storage</h3><button class=\"text-[10px] font-bold text-[#334E68]\">Upgrade</button></div><div class=\"h-1.5 w-full bg-[#F3F6F9] rounded-full overflow-hidden mb-3\"><div class=\"h-full bg-[#334E68] rounded-full\" style=\"width: 65%\"></div></div><div class=\"flex justify-between text-[10px] text-[#6B7280] font-medium\"><span>1.2GB Used</span><span>15GB Limit</span></div></div><div class=\"bg-white border border-[#E2E8F0] rounded-xl p-5 shadow-card flex flex-col items-center\"><div class=\"w-full mb-4 text-left\"><h3 class=\"text-xs font-bold uppercase text-[#1F2937]\">Efficiency Score</h3></div><div class=\"relative h-24 w-24 flex items-center justify-center mb-4\"><svg class=\"h-full w-full rotate-[-90deg]\" viewBox=\"0 0 128 128\"><circle cx=\"64\" cy=\"64\" r=\"58\" stroke=\"#F3F6F9\" stroke-width=\"8\" fill=\"none\"></circle><circle cx=\"64\" cy=\"64\" r=\"58\" stroke=\"#334E68\" stroke-width=\"8\" fill=\"none\" stroke-dasharray=\"364.4\" stroke-dashoffset=\"65\" stroke-linecap=\"round\"></circle></svg><div class=\"absolute text-center\"><p class=\"text-xl font-bold text-[#1F2937]\">82%</p></div></div><p class=\"text-[10px] text-[#6B7280] text-center leading-relaxed\">You saved <span class=\"font-bold text-[#334E68]\">4.2 hours</span> of manual drafting this week using AI tools.</p></div></div></div></main></div></div></body></html>",
