# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/craftsuite

# ── JWT — must match uamsatech.com AUTH_JWT_SECRET and ScholarCraft JWT_ACCESS_SECRET ──
JWT_ACCESS_SECRET=<min-32-char-random-string>
JWT_REFRESH_SECRET=<min-32-char-random-string-different-from-access>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cookies ───────────────────────────────────────────────────────────────────
COOKIE_SECRET=<min-32-char-random-string>
COOKIE_DOMAIN=.uamsatech.com

# ── App URLs ──────────────────────────────────────────────────────────────────
FRONTEND_URL=https://lecturercraft.uamsatech.com
APP_URL=https://api.lecturercraft.uamsatech.com

# ── SSO Enforcement ───────────────────────────────────────────────────────────
# Set to true to block direct /register — all users must come via uamsatech.com SSO
DISABLE_DIRECT_SIGNUP=true

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:<redis-password>@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ── SMTP (Resend / SendGrid / any SMTP) ───────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=<your-smtp-api-key>
SMTP_FROM=LectureCraft <noreply@lecturercraft.app>

# ── AI Providers (at least one required for AI features) ─────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=

# ── AWS S3 (for file uploads in production) ───────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ── Billing (at least one required for paid plans) ───────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
BILLING_DEFAULT_PROVIDER=stripe
TRIAL_DAYS=14

# ── Sentry Error Tracking (optional but recommended) ─────────────────────────
SENTRY_DSN=
