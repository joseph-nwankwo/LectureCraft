# ══════════════════════════════════════════════════════════════════════════════
# LectureSuite — PRODUCTION environment template
# Copy to backend/.env on your server and fill every value.
# NEVER commit this file once it has real values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── URLs — update these once your domain is confirmed ─────────────────────────
# If hosted as a subdomain of uamsatech.com:
FRONTEND_URL=https://lecturesuite.uamsatech.com
APP_URL=https://api.lecturesuite.uamsatech.com
# If hosted standalone:
# FRONTEND_URL=https://lecturesuite.app
# APP_URL=https://api.lecturesuite.app

# Extra CORS origin during domain migration (leave blank otherwise):
ADDITIONAL_FRONTEND_URLS=

# ── Database ──────────────────────────────────────────────────────────────────
# Railway / Neon / Supabase — copy the connection string from your provider
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/craftsuite?sslmode=require
POSTGRES_USER=craftsuite
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=craftsuite

# ── Redis ─────────────────────────────────────────────────────────────────────
# Railway Redis plugin URL, or Upstash REST URL
REDIS_URL=redis://default:PASSWORD@HOST:6379
REDIS_HOST=HOST
REDIS_PORT=6379
REDIS_PASSWORD=PASSWORD

# ── JWT / Auth secrets — PASTE the generated values below ─────────────────────
# (Run: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=PASTE_GENERATED_SECRET_HERE
JWT_REFRESH_SECRET=PASTE_DIFFERENT_GENERATED_SECRET_HERE
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=PASTE_GENERATED_COOKIE_SECRET_HERE
COOKIE_DOMAIN=.uamsatech.com

# ── SSO (Craft Suite shared secret — MUST MATCH portal + ScholarSuite) ────────
CRAFT_LAUNCH_SECRET=PASTE_CRAFT_LAUNCH_SECRET_HERE

# ── Central entitlement service ───────────────────────────────────────────────
CENTRAL_ENTITLEMENT_URL=https://uamsatech.com/api/internal/entitlements/verify
CENTRAL_ENTITLEMENT_SERVICE_SECRET=PASTE_ENTITLEMENT_SERVICE_SECRET_HERE
CENTRAL_ENTITLEMENT_TIMEOUT_MS=5000

# ── AI providers — set at least one ──────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Recommended: SendGrid (free 100/day) or Resend (free 3k/month)
# SendGrid:
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=SG.YOUR_SENDGRID_KEY_HERE
SMTP_FROM=LectureSuite <noreply@uamsatech.com>
# Resend alternative:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_YOUR_RESEND_KEY_HERE

# ── Billing / Payments — set at least one ─────────────────────────────────────
BILLING_DEFAULT_PROVIDER=stripe
TRIAL_DAYS=14

# Stripe (recommended):
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Paystack (Nigerian market):
PAYSTACK_SECRET_KEY=sk_live_...

# Flutterwave:
FLUTTERWAVE_SECRET_KEY=FLWSECK_LIVE-...

# ── AWS S3 (file uploads: avatars, documents, exports) ────────────────────────
# Or use Cloudflare R2 (S3-compatible, cheaper egress):
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY_HERE
AWS_S3_BUCKET=lecturesuite-prod-uploads
AWS_S3_BACKUP_BUCKET=lecturesuite-prod-backups

# ── Error tracking (highly recommended in production) ─────────────────────────
# Create a free project at sentry.io
SENTRY_DSN=https://YOUR_KEY@oNNNNNN.ingest.sentry.io/NNNNN

# ── Monitoring ────────────────────────────────────────────────────────────────
METRICS_SECRET=PASTE_GENERATED_METRICS_SECRET_HERE
GRAFANA_URL=https://metrics.lecturesuite.uamsatech.com
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
