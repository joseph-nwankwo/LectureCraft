generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  id                 String                   @id @default(cuid())
  name               String
  abbreviation       String?
  domain             String?                  @unique
  logo               String?
  contactEmail       String?
  contactPhone       String?
  website            String?
  address            String?
  city               String?
  state              String?
  country            String                   @default("Nigeria")
  timezone           String                   @default("Africa/Lagos")
  institutionType    InstitutionType          @default(UNIVERSITY)
  planTier           PlanTier                 @default(FREE)
  tenantStatus       TenantStatus             @default(TRIAL)
  maxUsers           Int                      @default(10)
  maxCourses         Int                      @default(50)
  storageLimitGb     Float                    @default(5.0)
  isActive           Boolean                  @default(true)
  settings           Json                     @default("{}")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  academicSessions   AcademicSession[]
  activityFeeds      ActivityFeed[]
  apiKeys            APIKey[]                 @relation("InstitutionAPIKeys")
  assessments        Assessment[]             @relation("InstitutionAssessments")
  auditLogs          AuditLog[]
  calendarEvents     CalendarEvent[]
  conversations      Conversation[]
  courses            Course[]
  departments        Department[]
  institutionDocs    Document[]               @relation("InstitutionDocuments")
  emailVerifications EmailVerificationToken[]
  exportTemplates    ExportTemplate[]
  faculties          Faculty[]
  folders            Folder[]
  subscription       InstitutionSubscription? @relation("InstitutionBillingSubscription")
  invoices           Invoice[]                @relation("InstitutionInvoices")
  learningOutcomes   LearningOutcome[]        @relation("InstitutionOutcomes")
  loginSessions      LoginSession[]
  notifications      Notification[]
  passwordResets     PasswordResetToken[]
  payments           Payment[]                @relation("InstitutionPayments")
  programmes         Programme[]
  promptTemplates    PromptTemplate[]
  questions          Question[]               @relation("InstitutionQuestions")
  reportTemplates    ReportTemplate[]         @relation("InstitutionReportTemplates")
  roles              Role[]
  rubrics            Rubric[]                 @relation("InstitutionRubrics")
  scheduledReports   ScheduledReport[]        @relation("InstitutionScheduledReports")
  semesters          Semester[]
  tags               Tag[]
  usageRecords       UsageRecord[]            @relation("InstitutionUsage")
  users              User[]
  workspaces         Workspace[]

  @@map("institutions")
}

model User {
  id                         String                     @id @default(cuid())
  email                      String                     @unique
  password                   String
  name                       String
  firstName                  String?
  lastName                   String?
  role                       UserRole                   @default(LECTURER)
  status                     UserStatus                 @default(ACTIVE)
  emailVerified              Boolean                    @default(false)
  lastLogin                  DateTime?
  failedAttempts             Int                        @default(0)
  lockedUntil                DateTime?
  department                 String?
  faculty                    String?
  title                      String?
  avatarUrl                  String?
  bio                        String?
  personalInstitutionName    String?
  personalInstitutionMotto   String?
  personalInstitutionLogoUrl String?
  personalInstitutionType    InstitutionType?
  institutionId              String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  activityFeeds              ActivityFeed[]             @relation("ActivityActor")
  aiGenerations              AIGeneration[]
  aiUsage                    AIUsage[]
  apiKeys                    APIKey[]                   @relation("APIKeyCreator")
  approvalActions            ApprovalWorkflow[]         @relation("ApprovalApprover")
  createdAssessments         Assessment[]               @relation("AssessmentCreator")
  gradedSubmissions          AssignmentSubmission[]     @relation("SubmissionGrader")
  submissions                AssignmentSubmission[]     @relation("StudentSubmissions")
  auditLogs                  AuditLog[]
  calendarEvents             CalendarEvent[]            @relation("CalendarCreator")
  authoredComments           Comment[]                  @relation("CommentAuthor")
  resolvedComments           Comment[]                  @relation("CommentResolver")
  conversationMemberships    ConversationMember[]
  assignedBy                 CourseAssignment[]         @relation("AssignmentAssigner")
  courseAssignments          CourseAssignment[]         @relation("LecturerAssignments")
  enrollments                CourseEnrollment[]         @relation("StudentEnrollments")
  uploadedMaterials          CourseMaterial[]           @relation("MaterialUploader")
  createdCourses             Course[]                   @relation("CourseCreator")
  hodOfDepartments           Department[]               @relation("DepartmentHOD")
  documentFavorites          DocumentFavorite[]
  documentVersions           DocumentVersion[]          @relation("DocumentVersionCreator")
  documents                  Document[]
  emailVerifications         EmailVerificationToken[]
  exportTemplates            ExportTemplate[]           @relation("ExportTemplateCreator")
  exports                    Export[]
  deanOfFaculties            Faculty[]                  @relation("FacultyDean")
  createdFolders             Folder[]                   @relation("FolderCreator")
  gpaCourses                 GpaCourse[]                @relation("GpaCourses")
  gpaSemesters               GpaSemester[]              @relation("GpaSemesters")
  createdOutcomes            LearningOutcome[]          @relation("OutcomeCreator")
  lecturerCourseEnrollments  LecturerCourseEnrollment[] @relation("LecturerCourseEnrollments")
  lecturerCourses            LecturerCourse[]           @relation("LecturerCourses")
  productivity               LecturerProductivity[]     @relation("UserProductivity")
  loginSessions              LoginSession[]
  givenMentions              Mention[]                  @relation("MentionAuthor")
  receivedMentions           Mention[]                  @relation("MentionTarget")
  messageReactions           MessageReaction[]
  sentMessages               Message[]                  @relation("MessageSender")
  notifications              Notification[]
  passwordResets             PasswordResetToken[]
  presence                   Presence?
  promptTemplates            PromptTemplate[]           @relation("TemplateCreator")
  moderations                QuestionModeration[]       @relation("ModerationReviewer")
  createdQuestions           Question[]                 @relation("QuestionCreator")
  refreshTokens              RefreshToken[]
  reportTemplates            ReportTemplate[]           @relation("ReportTemplateCreator")
  createdRubrics             Rubric[]                   @relation("RubricCreator")
  scheduledReports           ScheduledReport[]          @relation("ScheduledReportCreator")
  shareLinks                 ShareLink[]                @relation("ShareLinkCreator")
  studySessions              StudySession[]             @relation("StudySessions")
  studySubjects              StudySubject[]             @relation("StudySubjects")
  studyTasks                 StudyTask[]                @relation("StudyTasks")
  studyTimetableEntries      StudyTimetableEntry[]      @relation("StudyTimetableEntries")
  teachingSchedules          TeachingSchedule[]         @relation("LecturerSchedules")
  theses                     Thesis[]                   @relation("UserTheses")
  thesisChapters             ThesisChapter[]            @relation("UserThesisChapters")
  thesisCitations            ThesisCitation[]           @relation("UserThesisCitations")
  thesisReferenceDocuments   ThesisReferenceDocument[]  @relation("UserThesisReferenceDocuments")
  userProductRoles           UserProductRole[]
  announcements              ClassAnnouncement[]        @relation("AnnouncementAuthor")
  classPolls                 ClassPoll[]                @relation("PollAuthor")
  pollResponses              ClassPollResponse[]        @relation("PollResponses")
  classAssignmentsCreated    ClassAssignment[]          @relation("ClassAssignmentAuthor")
  classAssignmentSubmissions ClassAssignmentSubmission[] @relation("ClassAssignmentSubmissions")
  classAssignmentGraded      ClassAssignmentSubmission[] @relation("ClassAssignmentGrader")
  attendanceRecordsCreated   ClassAttendanceRecord[]    @relation("AttendanceCreator")
  attendanceEntries          AttendanceEntry[]          @relation("AttendanceEntries")
  discussionThreads          ClassDiscussionThread[]    @relation("DiscussionThreadAuthor")
  discussionReplies          ClassDiscussionReply[]     @relation("DiscussionReplyAuthor")
  roleAssignments            UserRoleAssignment[]
  institution                Institution?               @relation(fields: [institutionId], references: [id])
  workspaceMemberships       WorkspaceMember[]
  ownedWorkspaces            Workspace[]                @relation("WorkspaceOwner")

  @@map("users")
}

model UserProductRole {
  id        String   @id @default(cuid())
  userId    String
  product   String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, product])
  @@map("user_product_roles")
}

model LecturerCourse {
  id            String                     @id @default(cuid())
  createdBy     String
  title         String
  code          String?
  description   String?
  level         String
  credits       Int?
  semester      String?
  academicYear  String?
  department    String?
  faculty       String?
  enrollCode    String?                    @unique
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  assessments   Assessment[]               @relation("LecturerCourseAssessments")
  documents     Document[]                 @relation("LecturerCourseDocuments")
  enrollments   LecturerCourseEnrollment[]
  announcements     ClassAnnouncement[]
  sessions          ClassSession[]
  polls             ClassPoll[]
  assignments       ClassAssignment[]
  attendanceRecords ClassAttendanceRecord[]
  discussions       ClassDiscussionThread[]
  user              User                       @relation("LecturerCourses", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy])
  @@map("lecturer_courses")
}

model ClassAnnouncement {
  id        String         @id @default(cuid())
  courseId  String
  authorId  String
  title     String
  content   String         @db.Text
  isPinned  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  course    LecturerCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author    User           @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  @@index([courseId, createdAt])
  @@map("class_announcements")
}

model ClassSession {
  id           String         @id @default(cuid())
  courseId     String
  title        String
  description  String?
  scheduledAt  DateTime
  durationMins Int            @default(60)
  location     String?
  isOnline     Boolean        @default(false)
  meetLink     String?
  createdAt    DateTime       @default(now())
  course       LecturerCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, scheduledAt])
  @@map("class_sessions")
}

model ClassPoll {
  id        String              @id @default(cuid())
  courseId  String
  createdBy String
  question  String
  options   Json
  isActive  Boolean             @default(true)
  expiresAt DateTime?
  createdAt DateTime            @default(now())
  course    LecturerCourse      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author    User                @relation("PollAuthor", fields: [createdBy], references: [id])
  responses ClassPollResponse[]

  @@index([courseId, isActive])
  @@map("class_polls")
}

model ClassPollResponse {
  id             String    @id @default(cuid())
  pollId         String
  studentId      String
  selectedOption Int
  createdAt      DateTime  @default(now())
  poll           ClassPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  student        User      @relation("PollResponses", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([pollId, studentId])
  @@map("class_poll_responses")
}

model ClassAssignment {
  id            String                      @id @default(cuid())
  courseId      String
  createdBy     String
  title         String
  description   String?                     @db.Text
  dueDate       DateTime?
  totalMarks    Float?
  attachmentUrl String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  course        LecturerCourse              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author        User                        @relation("ClassAssignmentAuthor", fields: [createdBy], references: [id])
  submissions   ClassAssignmentSubmission[]

  @@index([courseId, dueDate])
  @@map("class_assignments")
}

model ClassAssignmentSubmission {
  id            String          @id @default(cuid())
  assignmentId  String
  studentId     String
  gradedBy      String?
  submissionUrl String?
  textContent   String?         @db.Text
  grade         Float?
  feedback      String?         @db.Text
  submittedAt   DateTime        @default(now())
  gradedAt      DateTime?
  assignment    ClassAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       User            @relation("ClassAssignmentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  grader        User?           @relation("ClassAssignmentGrader", fields: [gradedBy], references: [id])

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("class_assignment_submissions")
}

model ClassAttendanceRecord {
  id        String           @id @default(cuid())
  courseId  String
  date      DateTime         @db.Date
  createdBy String
  createdAt DateTime         @default(now())
  course    LecturerCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer  User             @relation("AttendanceCreator", fields: [createdBy], references: [id])
  entries   AttendanceEntry[]

  @@unique([courseId, date])
  @@index([courseId, date])
  @@map("class_attendance_records")
}

model AttendanceEntry {
  id        String                @id @default(cuid())
  recordId  String
  studentId String
  status    AttendanceStatus      @default(ABSENT)
  record    ClassAttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  student   User                  @relation("AttendanceEntries", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([recordId, studentId])
  @@map("attendance_entries")
}

model ClassDiscussionThread {
  id         String                 @id @default(cuid())
  courseId   String
  authorId   String
  title      String
  body       String                 @db.Text
  isPinned   Boolean                @default(false)
  isResolved Boolean                @default(false)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  course     LecturerCourse         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author     User                   @relation("DiscussionThreadAuthor", fields: [authorId], references: [id])
  replies    ClassDiscussionReply[]

  @@index([courseId, createdAt])
  @@map("class_discussion_threads")
}

model ClassDiscussionReply {
  id        String                @id @default(cuid())
  threadId  String
  authorId  String
  body      String                @db.Text
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  thread    ClassDiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User                  @relation("DiscussionReplyAuthor", fields: [authorId], references: [id])

  @@index([threadId, createdAt])
  @@map("class_discussion_replies")
}

model LecturerCourseEnrollment {
  id               String         @id @default(cuid())
  lecturerCourseId String
  studentId        String
  status           String         @default("ACTIVE")
  enrolledAt       DateTime       @default(now())
  course           LecturerCourse @relation(fields: [lecturerCourseId], references: [id], onDelete: Cascade)
  student          User           @relation("LecturerCourseEnrollments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lecturerCourseId, studentId])
  @@index([studentId])
  @@map("lecturer_course_enrollments")
}

model Role {
  id              String               @id @default(cuid())
  name            String
  slug            String
  description     String?
  isSystem        Boolean              @default(false)
  institutionId   String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  permissions     RolePermission[]
  institution     Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  userAssignments UserRoleAssignment[]

  @@unique([institutionId, slug])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  resource    String
  action      String
  description String?
  rolePerms   RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id          String    @id @default(cuid())
  userId      String
  roleId      String
  grantedById String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_role_assignments")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model LoginSession {
  id            String       @id @default(cuid())
  userId        String
  institutionId String?
  sessionToken  String       @unique
  userAgent     String?
  browser       String?
  device        String?
  os            String?
  ip            String?
  country       String?
  city          String?
  lastActiveAt  DateTime     @default(now())
  expiresAt     DateTime
  isRevoked     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  institution   Institution? @relation(fields: [institutionId], references: [id])
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@map("login_sessions")
}

model PasswordResetToken {
  id            String       @id @default(cuid())
  userId        String
  institutionId String?
  token         String       @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime     @default(now())
  institution   Institution? @relation(fields: [institutionId], references: [id])
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id            String       @id @default(cuid())
  userId        String
  institutionId String?
  token         String       @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime     @default(now())
  institution   Institution? @relation(fields: [institutionId], references: [id])
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verification_tokens")
}

model AuditLog {
  id            String       @id @default(cuid())
  userId        String?
  institutionId String?
  action        String
  resource      String?
  resourceId    String?
  oldValue      Json?
  newValue      Json?
  ip            String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  institution   Institution? @relation(fields: [institutionId], references: [id])
  user          User?        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([institutionId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id            String               @id @default(cuid())
  userId        String
  institutionId String?
  type          NotificationType     @default(INFO)
  title         String
  message       String
  data          Json?
  isRead        Boolean              @default(false)
  readAt        DateTime?
  archived      Boolean              @default(false)
  pinned        Boolean              @default(false)
  priority      NotificationPriority @default(NORMAL)
  category      NotificationCategory @default(SYSTEM)
  actionUrl     String?
  createdAt     DateTime             @default(now())
  institution   Institution?         @relation(fields: [institutionId], references: [id])
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, archived, createdAt])
  @@map("notifications")
}

model Faculty {
  id            String       @id @default(cuid())
  institutionId String
  name          String
  abbreviation  String?
  code          String
  description   String?
  logo          String?
  deanId        String?
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  departments   Department[]
  dean          User?        @relation("FacultyDean", fields: [deanId], references: [id])
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("faculties")
}

model Department {
  id            String      @id @default(cuid())
  facultyId     String
  institutionId String
  name          String
  abbreviation  String?
  code          String
  description   String?
  hodId         String?
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  courses       Course[]
  faculty       Faculty     @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  hod           User?       @relation("DepartmentHOD", fields: [hodId], references: [id])
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programmes    Programme[]

  @@unique([institutionId, code])
  @@index([institutionId, facultyId])
  @@map("departments")
}

model Programme {
  id                  String              @id @default(cuid())
  departmentId        String
  institutionId       String
  name                String
  abbreviation        String?
  degree              String
  duration            Int                 @default(4)
  studyMode           StudyMode           @default(FULL_TIME)
  accreditationStatus AccreditationStatus @default(PENDING)
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  courses             Course[]
  department          Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  institution         Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, departmentId])
  @@map("programmes")
}

model AcademicSession {
  id                String             @id @default(cuid())
  institutionId     String
  name              String
  startDate         DateTime
  endDate           DateTime
  current           Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  institution       Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseAssignments CourseAssignment[]
  enrollments       CourseEnrollment[]
  semesters         Semester[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("academic_sessions")
}

model Semester {
  id                String             @id @default(cuid())
  academicSessionId String
  institutionId     String
  name              String
  number            Int
  current           Boolean            @default(false)
  startDate         DateTime
  endDate           DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  courseAssignments CourseAssignment[]
  courses           Course[]
  academicSession   AcademicSession    @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  institution       Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  teachingSchedules TeachingSchedule[]

  @@unique([academicSessionId, number])
  @@index([institutionId])
  @@map("semesters")
}

model Course {
  id                   String                 @id @default(cuid())
  institutionId        String
  departmentId         String
  programmeId          String?
  semesterId           String?
  code                 String
  title                String
  description          String?
  creditUnits          Int                    @default(3)
  level                CourseLevel
  courseType           CourseType             @default(COMPULSORY)
  learningHours        Int?
  deliveryMode         DeliveryMode           @default(FACE_TO_FACE)
  active               Boolean                @default(true)
  deletedAt            DateTime?
  createdBy            String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  assessments          Assessment[]           @relation("CourseAssessments")
  submissionsForCourse AssignmentSubmission[]
  assignments          CourseAssignment[]
  enrollments          CourseEnrollment[]
  materials            CourseMaterial[]
  outcomes             CourseOutcome[]
  creator              User?                  @relation("CourseCreator", fields: [createdBy], references: [id])
  department           Department             @relation(fields: [departmentId], references: [id])
  institution          Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programme            Programme?             @relation(fields: [programmeId], references: [id])
  semester             Semester?              @relation(fields: [semesterId], references: [id])
  documents            Document[]
  learningOutcomes     LearningOutcome[]      @relation("CourseOutcomes")
  questions            Question[]             @relation("CourseQuestions")
  rubrics              Rubric[]               @relation("CourseRubrics")
  schedules            TeachingSchedule[]

  @@unique([institutionId, code])
  @@index([institutionId, departmentId])
  @@index([institutionId, active])
  @@map("courses")
}

model CourseAssignment {
  id                String          @id @default(cuid())
  lecturerId        String
  courseId          String
  academicSessionId String
  semesterId        String?
  role              AssignmentRole  @default(LEAD)
  assignedBy        String
  assignedDate      DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  assigner          User            @relation("AssignmentAssigner", fields: [assignedBy], references: [id])
  course            Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer          User            @relation("LecturerAssignments", fields: [lecturerId], references: [id])
  semester          Semester?       @relation(fields: [semesterId], references: [id])

  @@unique([lecturerId, courseId, academicSessionId])
  @@index([courseId])
  @@index([lecturerId])
  @@map("course_assignments")
}

model CourseOutcome {
  id          String     @id @default(cuid())
  courseId    String
  outcomeCode String
  description String
  bloomLevel  BloomLevel
  createdAt   DateTime   @default(now())
