  code            String                    @unique
  description     String?
  discountType    DiscountType
  discountValue   Decimal                   @db.Decimal(10, 2)
  expirationDate  DateTime?
  usageLimit      Int?
  usageCount      Int                       @default(0)
  active          Boolean                   @default(true)
  applicablePlans Json                      @default("[]")
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  redemptions     CouponRedemption[]
  subscriptions   InstitutionSubscription[]

  @@index([code, active])
  @@map("coupons")
}

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  institutionId String
  redeemedAt    DateTime @default(now())
  coupon        Coupon   @relation(fields: [couponId], references: [id])

  @@unique([couponId, institutionId])
  @@index([institutionId])
  @@map("coupon_redemptions")
}

model UsageRecord {
  id             String                   @id @default(cuid())
  institutionId  String
  subscriptionId String?
  metric         UsageMetricType
  value          BigInt                   @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  recordedAt     DateTime                 @default(now())
  institution    Institution              @relation("InstitutionUsage", fields: [institutionId], references: [id])
  subscription   InstitutionSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([institutionId, metric, periodStart])
  @@index([subscriptionId])
  @@map("usage_records")
}

model FeatureFlag {
  id       String            @id @default(cuid())
  planId   String?
  name     String
  enabled  Boolean           @default(true)
  metadata Json              @default("{}")
  plan     SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, name])
  @@index([name])
  @@map("feature_flags")
}

model APIKey {
  id            String      @id @default(cuid())
  institutionId String
  name          String
  keyHash       String      @unique
  keyPrefix     String
  scopes        Json        @default("[]")
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  active        Boolean     @default(true)
  createdBy     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  creator       User        @relation("APIKeyCreator", fields: [createdBy], references: [id])
  institution   Institution @relation("InstitutionAPIKeys", fields: [institutionId], references: [id])

  @@index([institutionId, active])
  @@index([keyPrefix])
  @@map("api_keys")
}

model Workspace {
  id             String              @id @default(cuid())
  institutionId  String
  name           String
  description    String?
  visibility     WorkspaceVisibility @default(PRIVATE)
  ownerId        String
  avatar         String?
  settings       Json                @default("{}")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  activityFeeds  ActivityFeed[]      @relation("WorkspaceActivity")
  calendarEvents CalendarEvent[]     @relation("WorkspaceCalendar")
  conversations  Conversation[]      @relation("WorkspaceConversations")
  members        WorkspaceMember[]
  institution    Institution         @relation(fields: [institutionId], references: [id])
  owner          User                @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  @@index([institutionId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String              @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceMemberRole @default(MEMBER)
  joinedAt    DateTime            @default(now())
  user        User                @relation(fields: [userId], references: [id])
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Conversation {
  id            String               @id @default(cuid())
  institutionId String
  workspaceId   String?
  name          String?
  description   String?
  type          ConversationType     @default(DIRECT)
  avatarUrl     String?
  pinnedMessage String?
  lastMessageAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  members       ConversationMember[]
  institution   Institution          @relation(fields: [institutionId], references: [id])
  workspace     Workspace?           @relation("WorkspaceConversations", fields: [workspaceId], references: [id])
  messages      Message[]

  @@index([institutionId, type])
  @@index([workspaceId])
  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  muted          Boolean      @default(false)
  archived       Boolean      @default(false)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  messageType    MessageType       @default(TEXT)
  attachments    Json              @default("[]")
  edited         Boolean           @default(false)
  deleted        Boolean           @default(false)
  threadId       String?
  pinnedAt       DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  mentions       Mention[]
  reactions      MessageReaction[]
  conversation   Conversation      @relation(fields: [conversationId], references: [id])
  sender         User              @relation("MessageSender", fields: [senderId], references: [id])
  thread         Message?          @relation("MessageThread", fields: [threadId], references: [id])
  replies        Message[]         @relation("MessageThread")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model Mention {
  id            String   @id @default(cuid())
  messageId     String?
  mentionedById String
  userId        String
  entityType    String   @default("message")
  entityId      String
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())
  mentionedBy   User     @relation("MentionAuthor", fields: [mentionedById], references: [id])
  message       Message? @relation(fields: [messageId], references: [id])
  user          User     @relation("MentionTarget", fields: [userId], references: [id])

  @@index([userId, read])
  @@index([mentionedById])
  @@map("mentions")
}

model ActivityFeed {
  id            String      @id @default(cuid())
  institutionId String
  workspaceId   String?
  actorId       String
  action        String
  entityType    String
  entityId      String
  entityTitle   String?
  metadata      Json        @default("{}")
  createdAt     DateTime    @default(now())
  actor         User        @relation("ActivityActor", fields: [actorId], references: [id])
  institution   Institution @relation(fields: [institutionId], references: [id])
  workspace     Workspace?  @relation("WorkspaceActivity", fields: [workspaceId], references: [id])

  @@index([institutionId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([actorId])
  @@map("activity_feeds")
}

model Presence {
  id         String         @id @default(cuid())
  userId     String         @unique
  status     PresenceStatus @default(OFFLINE)
  statusText String?
  lastSeenAt DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("presences")
}

model CalendarEvent {
  id            String            @id @default(cuid())
  institutionId String
  workspaceId   String?
  creatorId     String
  title         String
  description   String?
  eventType     CalendarEventType @default(OTHER)
  startAt       DateTime
  endAt         DateTime
  allDay        Boolean           @default(false)
  location      String?
  meetingUrl    String?
  attendees     Json              @default("[]")
  entityType    String?
  entityId      String?
  recurrence    Json?
  color         String?
  reminderSent  Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  creator       User              @relation("CalendarCreator", fields: [creatorId], references: [id])
  institution   Institution       @relation(fields: [institutionId], references: [id])
  workspace     Workspace?        @relation("WorkspaceCalendar", fields: [workspaceId], references: [id])

  @@index([institutionId, startAt])
  @@index([workspaceId])
  @@map("calendar_events")
}

model CourseEnrollment {
  id                String           @id @default(cuid())
  studentId         String
  courseId          String
  academicSessionId String?
  status            EnrollmentStatus @default(ACTIVE)
  enrolledAt        DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  academicSession   AcademicSession? @relation(fields: [academicSessionId], references: [id])
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student           User             @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, academicSessionId])
  @@index([studentId])
  @@index([courseId])
  @@map("course_enrollments")
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  studentId    String
  assessmentId String
  courseId     String?
  content      String?
  fileUrl      String?
  fileKey      String?
  fileName     String?
  fileSize     Int?
  fileType     String?
  status       SubmissionStatus @default(DRAFT)
  submittedAt  DateTime?
  grade        Float?
  feedback     String?
  gradedBy     String?
  gradedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  course       Course?          @relation(fields: [courseId], references: [id])
  grader       User?            @relation("SubmissionGrader", fields: [gradedBy], references: [id])
  student      User             @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, assessmentId])
  @@index([studentId])
  @@index([assessmentId])
  @@index([courseId])
  @@index([status])
  @@map("assignment_submissions")
}

model StudySubject {
  id               String                @id @default(cuid())
  userId           String
  name             String
  color            String                @default("#6366f1")
  description      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  sessions         StudySession[]
  user             User                  @relation("StudySubjects", fields: [userId], references: [id], onDelete: Cascade)
  tasks            StudyTask[]
  timetableEntries StudyTimetableEntry[]

  @@index([userId])
  @@map("study_subjects")
}

model StudyTask {
  id                    String            @id @default(cuid())
  userId                String
  subjectId             String?
  title                 String
  description           String?
  priority              StudyTaskPriority @default(MEDIUM)
  dueDate               DateTime?
  reminderMinutesBefore Int?
  completed             Boolean           @default(false)
  completedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  sessions              StudySession[]
  subject               StudySubject?     @relation(fields: [subjectId], references: [id])
  user                  User              @relation("StudyTasks", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subjectId])
  @@index([dueDate])
  @@map("study_tasks")
}

model StudySession {
  id              String        @id @default(cuid())
  userId          String
  subjectId       String?
  taskId          String?
  notes           String?
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int?
  createdAt       DateTime      @default(now())
  subject         StudySubject? @relation(fields: [subjectId], references: [id])
  task            StudyTask?    @relation(fields: [taskId], references: [id])
  user            User          @relation("StudySessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subjectId])
  @@index([startTime])
  @@map("study_sessions")
}

model GpaSemester {
  id        String      @id @default(cuid())
  userId    String
  name      String
  session   String?
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  courses   GpaCourse[]
  user      User        @relation("GpaSemesters", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gpa_semesters")
}

model GpaCourse {
  id          String      @id @default(cuid())
  semesterId  String
  userId      String
  name        String
  creditUnits Int
  score       Int
  passMark    Int         @default(40)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  semester    GpaSemester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user        User        @relation("GpaCourses", fields: [userId], references: [id], onDelete: Cascade)

  @@index([semesterId])
  @@index([userId])
  @@map("gpa_courses")
}

model StudyTimetableEntry {
  id        String        @id @default(cuid())
  userId    String
  subjectId String?
  title     String
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  subject   StudySubject? @relation(fields: [subjectId], references: [id])
  user      User          @relation("StudyTimetableEntries", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subjectId])
  @@map("study_timetable_entries")
}

model Thesis {
  id                 String                    @id @default(cuid())
  userId             String
  title              String
  field              String?
  degreeType         String?
  supervisorName     String?
  status             ThesisStatus              @default(DRAFT)
  proposalSections   Json                      @default("{}")
  assistantDocument  String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  user               User                      @relation("UserTheses", fields: [userId], references: [id], onDelete: Cascade)
  chapters           ThesisChapter[]
  citations          ThesisCitation[]
  referenceDocuments ThesisReferenceDocument[]

  @@index([userId])
  @@map("theses")
}

model ThesisChapter {
  id        String              @id @default(cuid())
  thesisId  String
  userId    String
  title     String
  order     Int                 @default(0)
  content   String?
  status    ThesisChapterStatus @default(NOT_STARTED)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  thesis    Thesis              @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  user      User                @relation("UserThesisChapters", fields: [userId], references: [id], onDelete: Cascade)

  @@index([thesisId])
  @@index([userId])
  @@map("thesis_chapters")
}

model ThesisCitation {
  id        String             @id @default(cuid())
  thesisId  String
  userId    String
  type      ThesisCitationType @default(JOURNAL)
  authors   String
  year      Int?
  title     String
  source    String?
  url       String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  thesis    Thesis             @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  user      User               @relation("UserThesisCitations", fields: [userId], references: [id], onDelete: Cascade)

  @@index([thesisId])
  @@index([userId])
  @@map("thesis_citations")
}

model ThesisReferenceDocument {
  id           String                  @id @default(cuid())
  thesisId     String
  userId       String
  fileName     String
  fileUrl      String
  fileType     String
  status       ReferenceDocumentStatus @default(PROCESSING)
  errorMessage String?
  chunkCount   Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  chunks       ThesisReferenceChunk[]
  thesis       Thesis                  @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  user         User                    @relation("UserThesisReferenceDocuments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([thesisId])
  @@index([userId])
  @@map("thesis_reference_documents")
}

model ThesisReferenceChunk {
  id         String                  @id @default(cuid())
  documentId String
  thesisId   String
  chunkIndex Int
  content    String
  embedding  Float[]
  createdAt  DateTime                @default(now())
  document   ThesisReferenceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([thesisId])
  @@map("thesis_reference_chunks")
}

